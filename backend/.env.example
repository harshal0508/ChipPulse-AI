# ChipPulse AI – Environment Configuration
# ==========================================
# Copy this file to .env and edit as needed.
# The backend works out-of-the-box with SQLite (default).

# ------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------

# Option A: SQLite (default, zero-config, recommended for development)
DATABASE_URL=sqlite+aiosqlite:///./chippulse.db

# Option B: PostgreSQL (production)
# Requires: pip install asyncpg
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chippulse

# ------------------------------------------------------------------
# CORS – comma-separated list of allowed frontend origins
# ------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------------------------------------------------------
# THERMAL LIMITS (used for violation detection)
# ------------------------------------------------------------------
THERMAL_THROTTLE_TEMP_C=90.0
EM_RISK_THRESHOLD=0.7

# ------------------------------------------------------------------
# SOLVER DEFAULTS
# ------------------------------------------------------------------
MAX_ITERATIONS=500
CONVERGENCE_DELTA=0.01

# ------------------------------------------------------------------
# DEBUG MODE
# ------------------------------------------------------------------
DEBUG=false
